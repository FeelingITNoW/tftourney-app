{
  "schemaVersion": 3,
  "id": "three-round-128-checkmate",
  "name": "128-Player Three-Round Checkmate",
  "startRequirement": {
    "minimumEntrants": 128,
    "exactEntrants": 128
  },
  "placementPoints": {
    "1": 8,
    "2": 7,
    "3": 6,
    "4": 5,
    "5": 4,
    "6": 3,
    "7": 2,
    "8": 1
  },
  "nodeDefaults": {
    "mergeSeeding": "random",
    "lobbySeeding": "snake",
    "games": 6,
    "reseed": 2,
    "standings": {
      "rankingMetric": "points",
      "sortDirection": "desc",
      "tieBreakers": [
        { "rankingMetric": "current_node_firsts", "sortDirection": "desc" },
        { "rankingMetric": "node_entry_seed", "sortDirection": "asc" }
      ]
    },
    "reseedStandings": {
      "rankingMetric": "tournament_points",
      "sortDirection": "desc",
      "tieBreakers": [
        { "rankingMetric": "current_node_firsts", "sortDirection": "desc" },
        { "rankingMetric": "node_entry_seed", "sortDirection": "asc" }
      ]
    }
  },
  "nodes": [
    {
      "id": "opening-round",
      "name": "Opening Round",
      "initialEntrantSlots": "all"
    },
    {
      "id": "second-round",
      "name": "Second Round"
    },
    {
      "id": "final-round",
      "name": "Checkmate Final",
      "lobbySeeding": "random",
      "reseed": 0,
      "winCondition": {
        "type": "checkmate",
        "threshold": 18
      }
    }
  ],
  "edges": [
    {
      "id": "opening-to-second",
      "sourceNodeId": "opening-round",
      "destinationNodeId": "second-round",
      "priority": 1,
      "condition": { "type": "top_n", "count": 64 }
    },
    {
      "id": "second-to-final",
      "sourceNodeId": "second-round",
      "destinationNodeId": "final-round",
      "priority": 1,
      "condition": { "type": "top_n", "count": 8 }
    }
  ]
}
