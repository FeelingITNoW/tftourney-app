# Copy this file to .env.local and fill in your Supabase project values.
#
# For the linked Supabase project in this workspace:
# NEXT_PUBLIC_SUPABASE_URL=https://pwhtssicqwaolxgpfoxw.supabase.co
#
# For local Supabase, run `supabase start`, then copy the API URL and
# service_role key from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for verifying Riot IDs during player registration.
RIOT_API_KEY=
RIOT_ACCOUNT_REGION=asia

# Google Sheets publishing. Configure the same OAuth client in Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SHEET_WORKER_SECRET=
TFTOURNEY_APP_URL=http://localhost:3000
TFT_REQUIRE_AUTH=true

# Used by the local Supabase Auth Google provider when running `supabase start`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional single-host development fallback. Prefer encrypted connection rows
# in organizer_google_connections for deployed environments.
GOOGLE_REFRESH_TOKEN=
