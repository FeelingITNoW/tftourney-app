# Copy this file to .env.local and fill in your Supabase project values.
#
# For the linked Supabase project in this workspace:
# NEXT_PUBLIC_SUPABASE_URL=https://pwhtssicqwaolxgpfoxw.supabase.co
#
# For local Supabase, run `supabase start`, then copy the API URL and
# service_role key from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for verifying Riot IDs during player registration.
RIOT_API_KEY=
RIOT_ACCOUNT_REGION=asia

# Google Sheets publishing. Configure the same OAuth client in Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SHEET_WORKER_SECRET=
# Number of queued work slots used by each Sheets worker invocation (1-10).
GOOGLE_SHEET_WORKER_CONCURRENCY=4
# Public origin used to build OAuth redirect URIs (Google and Discord) and
# invite/sync links. Must match an authorized redirect host in the Supabase and
# Discord portals. In production set this to the deployed domain, e.g.
# https://tftourney-app-production.up.railway.app (no trailing slash). A bare
# host with no scheme (some platforms, including Railway, generate a domain
# variable without one) is also accepted -- https:// is added automatically
# unless the host is localhost/127.0.0.1. Required in every deployed
# environment: without it, OAuth redirects fall back to the internal request
# host, which resolves to localhost behind a reverse proxy like Railway.
TFTOURNEY_APP_URL=http://localhost:3000
# Optional, bot only: origin the Discord bot calls the app API on (defaults to TFTOURNEY_APP_URL).
# On Railway: http://<app-service>.railway.internal:<PORT>
TFTOURNEY_INTERNAL_URL=
TFT_REQUIRE_AUTH=true

# OCR placement parsing. Use ADC locally (for example, a path to a service
# account JSON file outside the repository) or provide base64-encoded service
# account JSON for deployments that cannot mount a credential file.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_VISION_CREDENTIALS_BASE64=
OCR_API_SECRET=

# Discord Gateway worker and tournament provisioning.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_BOT_API_SECRET=

# Signs the stateless player session cookie set by player Discord sign-in.
# Optional: when unset, a signing key is derived from SUPABASE_SERVICE_ROLE_KEY
# instead, so player sign-in works without this variable. Set it explicitly
# (generate with `openssl rand -base64 32`) so player sessions survive a
# service-role-key rotation.
PLAYER_SESSION_SECRET=

# Used by the local Supabase Auth Google provider when running `supabase start`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional single-host development fallback. Prefer encrypted connection rows
# in organizer_google_connections for deployed environments.
GOOGLE_REFRESH_TOKEN=
